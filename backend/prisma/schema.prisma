generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  PASSENGER
  DRIVER
}
enum RequestStatus {
  REQUESTED
  MATCHED
  CANCELLED
}
enum PoolStatus {
  MATCHED
  ACCEPTED
  DRIVER_ARRIVED
  STARTED
  COMPLETED
  CANCELLED
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role Role
  createdAt DateTime @default(now())
  vehicle Vehicle?
  requests RideRequest[]
}
model Vehicle {
  id String @id @default(cuid())
  name String @unique
  capacity Int
  online Boolean @default(true)
  driverId String @unique
  driver User @relation(fields: [driverId], references: [id])
  pools Pool[]
}
model RideRequest {
  id String @id @default(cuid())
  passengerId String
  pickupZone String
  destinationZone String
  distanceKm Int
  seats Int @default(1)
  status RequestStatus @default(REQUESTED)
  createdAt DateTime @default(now())
  passenger User @relation(fields: [passengerId], references: [id])
  member PoolMember?
  @@index([passengerId, status])
}
model Pool {
  id String @id @default(cuid())
  vehicleId String
  pickupZone String
  status PoolStatus @default(MATCHED)
  createdAt DateTime @default(now())
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  members PoolMember[]
  events RideEvent[]
  @@index([vehicleId, status])
}
model PoolMember {
  id String @id @default(cuid())
  poolId String
  requestId String @unique
  seats Int
  farePaisa Int
  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  request RideRequest @relation(fields: [requestId], references: [id])
  @@index([poolId])
}
model RideEvent {
  id String @id @default(cuid())
  poolId String
  status PoolStatus
  createdAt DateTime @default(now())
  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)
}
